# Скопировать в .env (`cp .env.example .env`) и внести в окружение:
# `set -a && . ./.env && set +a`. Имена те же, что читает api, — при желании
# можно взять его ../api/.env целиком.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/remember

# Объектное хранилище: локально MinIO из ../api/docker-compose.yml, в проде —
# Google Cloud Storage (тот же S3-протокол; R2_ENDPOINT=https://storage.googleapis.com
# и HMAC-ключ бакета — docs/running.md, «Хранилище Google»). Имена R2_* остались
# от прежнего хранилища. Без всех четырёх падают и превью, и уборка оборванных загрузок.
R2_ENDPOINT=http://localhost:9000
R2_BUCKET=remember
R2_ACCESS_KEY_ID=remember
R2_SECRET_ACCESS_KEY=remember-secret

# Google советует `auto`; MinIO подписывает us-east-1, если не сказать иное.
# R2_REGION=auto

# Куда постучаться, когда ролик готов, и общий секрет этого стука — тот же
# INTERNAL_WORKER_TOKEN, что стоит у api. Не заданы (или api не ответил) —
# воркер пишет предупреждение в лог и идёт дальше: ролик уже готов, теряется
# только пуш «ролик готов».
API_URL=http://localhost:3000
INTERNAL_WORKER_TOKEN=

# Облачная нейросеть: кто разбирает материал и строит план ролика. Не задано —
# воркер в сеть не ходит, пишет в лог, что вызов пропущен, и собирает ролик
# своим отбором, как сейчас. Ключ даёт человек (decision-10 ещё открыт).
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
#
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.5
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# Лимиты из architecture.md (MEDIA_MAX_FILE_BYTES, MEDIA_MAX_VIDEO_SECONDS,
# MEMORY_MAX_STORAGE_BYTES, MEMORY_MAX_FILES) проверяет api при выдаче ссылки
# на загрузку — воркер их не читает. Список со значениями — в ../api/.env.example.
